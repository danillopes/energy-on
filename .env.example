# Endereço público do site (usado em links de produto, Open Graph, sitemap e mensagens do WhatsApp)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Instagram Graph API (opcional). Sem estas variáveis, a seção usa as imagens demonstrativas.
# Requer conta profissional do Instagram vinculada a uma Página do Facebook e um token de longa duração.
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# Passeio 360° (opcional). Sem esta chave o site usa o código de incorporação padrão do Google Maps.
# Se usar, restrinja a chave no Google Cloud: API "Maps Embed API" + referenciadores HTTP do seu domínio.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
